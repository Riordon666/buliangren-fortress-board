# 生产环境推荐使用绝对路径；未设置时沿用项目目录下的现有位置。
DATABASE_PATH=/www/wwwroot/buliangren-fortress-board/data/naruto-fortress.db
UPLOAD_DIR=/www/wwwroot/buliangren-fortress-board/public/uploads
BACKUP_DIR=/www/backup/buliangren-fortress-board
REPORT_CACHE_DIR=/www/wwwroot/buliangren-fortress-board/data/report-cache

# 仅在首次创建空数据库时使用。已有数据库不会读取它。
INITIAL_PASSWORD=
# 只有明确需要初始化全新生产数据库时才设置为 1。
ALLOW_DATABASE_INIT=0

# Bot API 网站端只保存高强度原始 Token 的 SHA-256（64 位十六进制）。
# 禁止把原始 Token 写入网站环境变量、Git、日志或文档。
BOT_API_TOKEN_SHA256=

# 木叶快报缓存，可选；默认位于 DATABASE_PATH 所在目录的 news-cache/。
# NEWS_CACHE_DIR=/www/wwwroot/buliangren-fortress-board/data/news-cache

# 木叶快报邮件订阅：全部配置有效后才开放订阅，不使用邮箱登录密码。
# 邮箱站先部署专用发信接口，详见 docs/NEWS_EMAIL.md。
NEWS_MAIL_API_URL=https://mail.riordon.xyz/api/integrations/konoha/send
NEWS_MAIL_API_TOKEN=
NEWS_SUBSCRIPTION_SECRET=
NEWS_PUBLIC_URL=https://naruto.riordon.xyz
